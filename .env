# Profile Section Configuration
VITE_PROFILE_TITLE="Pusat Unggulan Studi Al-Qur'an & Tafsir Terpadu"
VITE_PROFILE_DESC="Program Studi Ilmu Al-Qur'an dan Tafsir (IAT) Fakultas Ushuluddin STAI Al-Mannan berkomitmen menyelenggarakan pendidikan tinggi Islam yang memadukan kedalaman khazanah tafsir klasik (turats), metodologi riset kontemporer, kajian living Qur'an, serta teknologi studi Al-Qur'an digital guna melahirkan mufassir, akademisi, dan da'i yang unggul dan solutif bagi peradaban."
VITE_PROFILE_IMAGE="/gedung.jpg"

# About Page Configuration
VITE_ABOUT_VISI="Menjadi Program Studi Ilmu Al-Qur'an dan Tafsir yang Unggul, Berakar pada Turats Islamiyah, dan Berdaya Saing Global dalam Pengembangan Keilmuan Al-Qur'an serta Pemberdayaan Masyarakat pada Tahun 2030."
VITE_ABOUT_MISI='["Menyelenggarakan pendidikan dan pengajaran Ilmu Al-Qur'\''an dan Tafsir berkualitas tinggi berbasis integrasi turats dan metodologi modern.", "Mengembangkan riset inovatif dalam bidang studi naskah tafsir nusantara, living Qur'\''an, dan digital quranic studies.", "Melaksanakan pengabdian kepada masyarakat melalui pembinaan tahfidz, dakwah Al-Qur'\''an, dan literasi keislaman.", "Menjalin kemitraan strategis dengan perguruan tinggi Islam, pusat riset Al-Qur'\''an nasional dan internasional."]'
VITE_ABOUT_HISTORY="Program Studi Ilmu Al-Qur'an dan Tafsir (IAT) didirikan di bawah naungan Fakultas Ushuluddin STAI Al-Mannan untuk menjawab kebutuhan umat akan lahirnya generasi yang memahami Al-Qur'an secara mendalam, moderat, dan berintelektual tinggi. Dengan perpaduan tradisi pesantren dan tradisi akademik universitas riset, IAT STAI Al-Mannan terus melahirkan lulusan bergelar S.Ag yang berkiprah luas di berbagai lini kehidupan umat dan bangsa."
VITE_ABOUT_STRUKTUR='{"pimpinan": "Ketua Program Studi (Kaprodi)", "nama": "Dr. H. Muhammad Arifin, M.Ag., Al-Hafizh", "staff": [{"role": "Sekretaris Prodi", "name": "Ust. Ahmad Fauzan, M.Hum"}, {"role": "Ketua Lab Al-Qur'\''an", "name": "Ust. H. Ridwan Kamil, Lc., M.Ag"}, {"role": "Koordinator Tahfidz & Sanad", "name": "Usth. Hj. Nurul Hidayah, M.Pd., Al-Hafizhah"}, {"role": "Gugus Penjamin Mutu", "name": "Dr. Siti Fatimah, M.Ag"}]}'
VITE_ABOUT_IMAGE="/gedung.jpg"

# Testimonials / Kata Mutiara Configuration
VITE_HOME_TESTIMONIALS='[{"text":"Sebaik-baik kalian adalah orang yang mempelajari Al-Qur'\''an dan mengajarkannya.","author":"HR. Bukhari","image":"/logokampus.jpg"},{"text":"Al-Qur'\''an adalah samudera ilmu yang tak bertepi, setiap generasi wajib menggali mutiaranya sesuai tantangan zamannya.","author":"Imam Fakhruddin Ar-Razi","image":"/logokampus.jpg"},{"text":"Mempelajari tafsir di IAT STAI Al-Mannan membuka cakrawala pemikiran yang luas: memahami teks suci secara mendalam sekaligus kontekstual dengan realitas masyarakat modern.","author":"Ahmad Baihaqi, S.Ag (Alumni & Peneliti Qur'\''an)","image":"/logokampus.jpg"}]'
